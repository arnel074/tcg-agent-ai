# Light, frequent orchestration calls. Needs a big monthly cap
LLM_PIPELINE=opencode/big-pickle

# Reads the most tokens. Biggest quota and biggest cap ($100)
LLM_INVESTIGATE=opencode/deepseek-v4.1-flash-free

# Once per task, so the $15 cap holds
LLM_PLAN=opencode/deepseek-v4.1-flash-free

# Heaviest stage, so code-tuned with a $60 cap
LLM_BUILD=opencode/big-pickle

# Runs after every build, so it needs a $60 cap. Different family from the builder
LLM_REVIEW=opencode/deepseek-v4.1-flash-free
# Mechanical fixes. Shares the $100 DeepSeek Flash budget
LLM_IMPROVE=opencode/deepseek-v4.1-flash-free

# Once per task, so the $15 cap is fine. Third family
LLM_REVIEW_FINAL=opencode/deepseek-v4.1-flash-free