{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "python3 *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit -m *", "effect": "allow" },
    { "action": "shell", "resource": "graphify query *", "effect": "allow" },
    { "action": "shell", "resource": "rtk *", "effect": "allow" },
    { "action": "shell", "resource": "fallow *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "~/.cache/opencode/**",
      "effect": "allow"
    }
  ],
  "plugin": ["@dietrichgebert/ponytail"],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp"]
      },
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      }
    }
  }

}