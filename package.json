{
  "name": "tcg-agent-ai",
  "private": true,
  "scripts": {
    "audit:check": "pnpm audit --audit-level high",
    "audit:fix": "pnpm audit --fix update --audit-level high",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "coverage": "turbo run test -- --coverage",
    "coverage:api": "turbo run test --filter=api -- --coverage",
    "coverage:web": "turbo run test --filter=web -- --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "fallow": "^3.43.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.11",
    "typescript": "7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}